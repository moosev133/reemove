{
  "rules": {
    ".read": false,
    ".write": false,
    "messaging_acl": {
      "$conversationId": {
        "$uid": {
          ".read": false,
          ".write": false,
          ".validate": "newData.val() === true || !newData.exists()"
        }
      }
    },
    "presence": {
      "$conversationId": {
        ".read": "auth != null && root.child('messaging_acl').child($conversationId).child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('messaging_acl').child($conversationId).child(auth.uid).val() === true",
          ".validate": "!newData.exists() || (newData.hasOnly(['state', 'lastChanged']) && newData.child('state').isString() && (newData.child('state').val() === 'online' || newData.child('state').val() === 'away') && newData.child('lastChanged').isNumber())"
        }
      }
    },
    "typing": {
      "$conversationId": {
        ".read": "auth != null && root.child('messaging_acl').child($conversationId).child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('messaging_acl').child($conversationId).child(auth.uid).val() === true",
          ".validate": "!newData.exists() || (newData.hasOnly(['isTyping', 'updatedAt']) && newData.child('isTyping').isBoolean() && newData.child('updatedAt').isNumber())"
        }
      }
    }
  }
}
