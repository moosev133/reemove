rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasOnlyKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function hasRequiredKeys(data, requiredKeys) {
      return data.keys().hasAll(requiredKeys);
    }

    function validCreateAudit(data) {
      return data.createdAt == request.time
        && data.updatedAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function validUpdateAudit() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }

    function isPublicActive(data) {
      return data.visibility == 'public'
        && data.moderationState == 'active';
    }

    function isBlocked(viewerId, authorId) {
      return exists(/databases/$(database)/documents/users/$(viewerId)/blocks/$(authorId))
        || exists(/databases/$(database)/documents/users/$(authorId)/blocks/$(viewerId));
    }

    function follows(viewerId, authorId) {
      return exists(/databases/$(database)/documents/users/$(authorId)/followers/$(viewerId));
    }

    function canReadUserProfile(uid, data) {
      return signedIn()
        && data.moderationState == 'active'
        && !isBlocked(request.auth.uid, uid)
        && (
          request.auth.uid == uid
          || data.visibility == 'public'
          || (data.visibility == 'followers'
            && follows(request.auth.uid, uid))
        );
    }

    function canReadPublishedContent(data) {
      return signedIn()
        && data.moderationState == 'active'
        && !isBlocked(request.auth.uid, data.authorId)
        && (
          request.auth.uid == data.authorId
          || (
            data.status == 'published'
            && (
              data.visibility == 'public'
              || (data.visibility == 'followers'
                && follows(request.auth.uid, data.authorId))
            )
          )
        );
    }

    function canReadStory(data) {
      return signedIn()
        && data.moderationState == 'active'
        && data.expiresAt > request.time
        && !isBlocked(request.auth.uid, data.authorId)
        && (
          request.auth.uid == data.authorId
          || data.visibility == 'public'
          || (data.visibility == 'followers'
            && follows(request.auth.uid, data.authorId))
        );
    }

    function validPublicUserCreate(uid) {
      let data = request.resource.data;
      return isOwner(uid)
        && hasOnlyKeys(data, [
          'uid',
          'username',
          'usernameNormalized',
          'displayName',
          'bio',
          'avatarUrl',
          'coverUrl',
          'websiteUrl',
          'primarySportId',
          'professionalDetails',
          'role',
          'isVerified',
          'verificationType',
          'favoriteSportIds',
          'sportLevels',
          'goals',
          'location',
          'geohash',
          'locality',
          'administrativeArea',
          'countryCode',
          'discoveryRadiusKm',
          'visibility',
          'followApprovalPolicy',
          'followersCount',
          'followingCount',
          'postsCount',
          'reelsCount',
          'onboardingCompleted',
          'createdAt',
          'updatedAt',
          'schemaVersion',
          'moderationState'
        ])
        && hasRequiredKeys(data, [
          'uid',
          'username',
          'usernameNormalized',
          'displayName',
          'role',
          'isVerified',
          'verificationType',
          'favoriteSportIds',
          'sportLevels',
          'goals',
          'discoveryRadiusKm',
          'visibility',
          'followApprovalPolicy',
          'followersCount',
          'followingCount',
          'postsCount',
          'reelsCount',
          'onboardingCompleted',
          'moderationState',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && validCreateAudit(data)
        && data.uid == uid
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 30
        && data.usernameNormalized is string
        && data.usernameNormalized.matches('^[a-z0-9._]{3,30}$')
        && exists(/databases/$(database)/documents/usernames/$(data.usernameNormalized))
        && get(/databases/$(database)/documents/usernames/$(data.usernameNormalized)).data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.role == 'athlete'
        && data.isVerified == false
        && data.verificationType == 'none'
        && data.favoriteSportIds is list
        && data.favoriteSportIds.size() <= 20
        && data.sportLevels is map
        && data.goals is list
        && data.goals.size() <= 20
        && data.discoveryRadiusKm is number
        && data.discoveryRadiusKm >= 1
        && data.discoveryRadiusKm <= 200
        && data.visibility in ['public', 'followers', 'private']
        && data.followApprovalPolicy in ['automatic', 'approvalRequired']
        && data.followersCount == 0
        && data.followingCount == 0
        && data.postsCount == 0
        && data.reelsCount == 0
        && data.moderationState == 'active';
    }

    function validPublicUserUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(uid)
        && changed.hasOnly([
          'displayName',
          'bio',
          'visibility',
          'updatedAt'
        ])
        && validUpdateAudit()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.favoriteSportIds is list
        && request.resource.data.favoriteSportIds.size() <= 20
        && request.resource.data.sportLevels is map
        && request.resource.data.goals is list
        && request.resource.data.goals.size() <= 20
        && request.resource.data.discoveryRadiusKm is number
        && request.resource.data.discoveryRadiusKm >= 1
        && request.resource.data.discoveryRadiusKm <= 200
        && request.resource.data.visibility in ['public', 'followers', 'private'];
    }

    function validPrivateProfile(uid, documentId) {
      let data = request.resource.data;
      return isOwner(uid)
        && documentId in ['profile', 'profile_settings', 'preferences', 'consents']
        && data.keys().size() <= 40
        && (!('uid' in data) || data.uid == uid)
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;

      match /private/{documentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /blocks/{targetUserId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /blocked_by/{blockerUserId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /followers/{followerId} {
        allow get: if isOwner(uid)
          || (signedIn() && request.auth.uid == followerId);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /following/{followingId} {
        allow get, list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /follow_requests/{requestId} {
      allow read, write: if false;
    }

    match /verification_requests/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /sports/{sportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feature_flags/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /places/{placeId} {
      allow get: if signedIn() && isPublicActive(resource.data);
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && request.query.limit <= 50;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow get: if signedIn() && isPublicActive(resource.data)
        && resource.data.status == 'published';
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && resource.data.status == 'published'
        && request.query.limit <= 50;
      allow write: if isAdmin();

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /challenges/{challengeId} {
      allow get: if signedIn() && isPublicActive(resource.data)
        && resource.data.status in ['scheduled', 'active', 'completed'];
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && resource.data.status in ['scheduled', 'active', 'completed']
        && request.query.limit <= 50;
      allow write: if isAdmin();

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /marketplace_listings/{listingId} {
      allow get: if signedIn()
        && resource.data.status == 'active'
        && resource.data.moderationState == 'active';
      allow list: if signedIn()
        && resource.data.status == 'active'
        && resource.data.moderationState == 'active'
        && request.query.limit <= 50;
      allow write: if isAdmin();

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /posts/{postId} {
      allow get: if canReadPublishedContent(resource.data);
      allow list: if signedIn()
        && resource.data.status == 'published'
        && resource.data.visibility == 'public'
        && resource.data.moderationState == 'active'
        && request.query.limit <= 25;
      allow write: if false;

      match /comments/{commentId} {
        allow get: if canReadPublishedContent(
          get(/databases/$(database)/documents/posts/$(postId)).data
        ) && resource.data.moderationState == 'active';
        allow list: if canReadPublishedContent(
          get(/databases/$(database)/documents/posts/$(postId)).data
        ) && resource.data.moderationState == 'active'
          && request.query.limit <= 50;
        allow write: if false;
      }
    }

    match /stories/{storyId} {
      allow get: if canReadStory(resource.data);
      allow list: if signedIn()
        && resource.data.visibility == 'public'
        && resource.data.moderationState == 'active'
        && resource.data.expiresAt > request.time
        && request.query.limit <= 50;
      allow write: if false;
    }

    match /feed_entries/{entryId} {
      allow get: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow list: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.query.limit <= 25;
      allow write: if false;
    }

    match /content_reactions/{reactionId} {
      allow get: if signedIn()
        && reactionId.matches(request.auth.uid + '--.*');
      allow list: if false;
      allow write: if false;
    }

    match /reposts/{repostId} {
      allow get: if signedIn()
        && repostId.matches(request.auth.uid + '--.*');
      allow list: if signedIn()
        && resource.data.reposterId == request.auth.uid
        && request.query.limit <= 50;
      allow write: if false;
    }

    match /comment_reactions/{reactionId} {
      allow get: if signedIn()
        && reactionId.matches(request.auth.uid + '--.*');
      allow list, write: if false;
    }

    match /story_views/{viewId} {
      allow get: if signedIn()
        && viewId.matches(request.auth.uid + '--.*');
      allow list, write: if false;
    }

    match /post_views/{viewId} {
      allow read, write: if false;
    }

    match /media_assets/{assetId} {
      allow get: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow list, write: if false;
    }

    match /media_jobs/{jobId} {
      allow get: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow list, write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && hasOnlyKeys(request.resource.data, [
          'reporterId',
          'targetType',
          'targetId',
          'reason',
          'details',
          'status',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && hasRequiredKeys(request.resource.data, [
          'reporterId',
          'targetType',
          'targetId',
          'reason',
          'status',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && validCreateAudit(request.resource.data)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in [
          'user', 'post', 'comment', 'story', 'message', 'group',
          'event', 'challenge', 'marketplace_listing'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 100
        && (!('details' in request.resource.data)
          || (request.resource.data.details is string
            && request.resource.data.details.size() <= 2000))
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    match /moderation_queue/{documentId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /data_migrations/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /account_deletions/{documentId} {
      allow read, write: if false;
    }

    match /rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
