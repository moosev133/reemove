rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function hasOnlyKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function hasRequiredKeys(data, requiredKeys) {
      return data.keys().hasAll(requiredKeys);
    }

    function validCreateAudit(data) {
      return data.createdAt == request.time
        && data.updatedAt == request.time
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function validUpdateAudit() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }

    function isPublicActive(data) {
      return data.visibility == 'public'
        && data.moderationState == 'active';
    }

    function isBlocked(viewerId, authorId) {
      return exists(/databases/$(database)/documents/users/$(viewerId)/blocks/$(authorId))
        || exists(/databases/$(database)/documents/users/$(authorId)/blocks/$(viewerId));
    }

    function follows(viewerId, authorId) {
      return exists(/databases/$(database)/documents/users/$(authorId)/followers/$(viewerId));
    }

    function isCommunityManager(communityId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(communityId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(communityId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/teams/$(communityId)/members/$(request.auth.uid)).data.role in ['owner', 'administrator'];
    }

    function canReadChallenge(challengeId) {
      let data = get(
        /databases/$(database)/documents/challenges/$(challengeId)
      ).data;
      return signedIn()
        && (
          isAdmin()
          || data.creatorId == request.auth.uid
          || (
            isPublicActive(data)
            && data.status in ['scheduled', 'active', 'completed']
          )
        );
    }

    function canManageChallenge(challengeId) {
      let data = get(
        /databases/$(database)/documents/challenges/$(challengeId)
      ).data;
      return signedIn()
        && (
          isAdmin()
          || data.creatorId == request.auth.uid
          || (
            data.communityId is string
            && isCommunityManager(data.communityId)
          )
        );
    }

    function activeConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/conversations/$(conversationId)/members/$(request.auth.uid)).data.removedAt == null;
    }

    function canReadUserProfile(uid, data) {
      // Account privacy is stored in users.visibility:
      // public | followers (private account) | private (owner-only account).
      return signedIn()
        && data.moderationState == 'active'
        && !isBlocked(request.auth.uid, uid)
        && (
          request.auth.uid == uid
          || data.visibility == 'public'
          || (data.visibility == 'followers'
            && follows(request.auth.uid, uid))
        );
    }

    function canReadPublishedContent(data) {
      return signedIn()
        && data.moderationState == 'active'
        && !isBlocked(request.auth.uid, data.authorId)
        && (
          request.auth.uid == data.authorId
          || (
            data.status == 'published'
            && (
              data.visibility == 'public'
              || (data.visibility == 'followers'
                && follows(request.auth.uid, data.authorId))
            )
          )
        );
    }

    function canReadStory(data) {
      return signedIn()
        && data.moderationState == 'active'
        && data.expiresAt > request.time
        && !isBlocked(request.auth.uid, data.authorId)
        && (
          request.auth.uid == data.authorId
          || data.visibility == 'public'
          || (data.visibility == 'followers'
            && follows(request.auth.uid, data.authorId))
        );
    }

    function canReadMarketplaceListing(data) {
      return signedIn()
        && !isBlocked(request.auth.uid, data.sellerId)
        && (
          data.sellerId == request.auth.uid
          || (
            data.moderationState == 'active'
            && data.status in ['active', 'reserved']
            && (!('expiresAt' in data) || data.expiresAt > request.time)
          )
        );
    }

    function validPublicUserCreate(uid) {
      let data = request.resource.data;
      return isOwner(uid)
        && hasOnlyKeys(data, [
          'uid',
          'username',
          'usernameNormalized',
          'displayName',
          'bio',
          'avatarUrl',
          'coverUrl',
          'websiteUrl',
          'primarySportId',
          'professionalDetails',
          'role',
          'isVerified',
          'verificationType',
          'favoriteSportIds',
          'sportLevels',
          'goals',
          'location',
          'geohash',
          'locality',
          'administrativeArea',
          'countryCode',
          'discoveryRadiusKm',
          'visibility',
          'followApprovalPolicy',
          'followersCount',
          'followingCount',
          'postsCount',
          'reelsCount',
          'onboardingCompleted',
          'createdAt',
          'updatedAt',
          'schemaVersion',
          'moderationState'
        ])
        && hasRequiredKeys(data, [
          'uid',
          'username',
          'usernameNormalized',
          'displayName',
          'role',
          'isVerified',
          'verificationType',
          'favoriteSportIds',
          'sportLevels',
          'goals',
          'discoveryRadiusKm',
          'visibility',
          'followApprovalPolicy',
          'followersCount',
          'followingCount',
          'postsCount',
          'reelsCount',
          'onboardingCompleted',
          'moderationState',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && validCreateAudit(data)
        && data.uid == uid
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 30
        && data.usernameNormalized is string
        && data.usernameNormalized.matches('^[a-z0-9._]{3,30}$')
        && exists(/databases/$(database)/documents/usernames/$(data.usernameNormalized))
        && get(/databases/$(database)/documents/usernames/$(data.usernameNormalized)).data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.role == 'athlete'
        && data.isVerified == false
        && data.verificationType == 'none'
        && data.favoriteSportIds is list
        && data.favoriteSportIds.size() <= 20
        && data.sportLevels is map
        && data.goals is list
        && data.goals.size() <= 20
        && data.discoveryRadiusKm is number
        && data.discoveryRadiusKm >= 1
        && data.discoveryRadiusKm <= 200
        && data.visibility in ['public', 'followers', 'private']
        && data.followApprovalPolicy in ['automatic', 'approvalRequired']
        && data.followersCount == 0
        && data.followingCount == 0
        && data.postsCount == 0
        && data.reelsCount == 0
        && data.moderationState == 'active';
    }

    function validPublicUserUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(uid)
        && changed.hasOnly([
          'displayName',
          'bio',
          'visibility',
          'updatedAt'
        ])
        && validUpdateAudit()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.favoriteSportIds is list
        && request.resource.data.favoriteSportIds.size() <= 20
        && request.resource.data.sportLevels is map
        && request.resource.data.goals is list
        && request.resource.data.goals.size() <= 20
        && request.resource.data.discoveryRadiusKm is number
        && request.resource.data.discoveryRadiusKm >= 1
        && request.resource.data.discoveryRadiusKm <= 200
        && request.resource.data.visibility in ['public', 'followers', 'private'];
    }

    function validPrivateProfile(uid, documentId) {
      let data = request.resource.data;
      return isOwner(uid)
        && documentId in ['profile', 'profile_settings', 'preferences', 'consents']
        && data.keys().size() <= 40
        && (!('uid' in data) || data.uid == uid)
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      // Owners may always read their own profile doc, including before the
      // provisionAccount function creates it (resource.data on a missing doc
      // errors inside canReadUserProfile and would deny first-time users).
      allow get: if isOwner(uid)
        || (resource != null && canReadUserProfile(uid, resource.data))
        || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create, update, delete: if false;

      match /private/{documentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /blocks/{targetUserId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /blocked_by/{blockerUserId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /followers/{followerId} {
        allow get: if isOwner(uid)
          || (signedIn() && request.auth.uid == followerId);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /following/{followingId} {
        allow get, list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /conversation_inbox/{conversationId} {
        allow get, list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /message_reactions/{reactionId} {
        allow get, list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /device_tokens/{tokenId} {
        allow get, list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /notification_events/{eventId} {
        allow read, write: if false;
      }

      match /challenge_badges/{badgeId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow write: if false;
      }

      match /marketplace_favorites/{listingId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit <= 200;
        allow write: if false;
      }

      match /marketplace_views/{listingId} {
        allow get: if isOwner(uid);
        allow list: if false;
        allow write: if false;
      }

      match /ai_outputs/{outputId} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if (isOwner(uid) || isAdmin()) && request.query.limit <= 100;
        allow write: if false;
      }

      match /ai_conversations/{conversationId} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if (isOwner(uid) || isAdmin()) && request.query.limit <= 100;
        allow write: if false;

        match /messages/{messageId} {
          allow get: if isOwner(uid) || isAdmin();
          allow list: if (isOwner(uid) || isAdmin())
            && request.query.limit <= 100;
          allow write: if false;
        }
      }

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /follow_requests/{requestId} {
      allow read, write: if false;
    }

    match /verification_requests/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /sports/{sportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feature_flags/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /places/{placeId} {
      allow get: if signedIn() && isPublicActive(resource.data);
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && request.query.limit <= 50;
      allow write: if isAdmin();
    }

    match /nearby_entities/{entityId} {
      allow read, write: if false;
    }

    match /sports_routes/{routeId} {
      allow get: if signedIn() && isPublicActive(resource.data);
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && request.query.limit <= 50;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow get: if signedIn() && isPublicActive(resource.data)
        && resource.data.status == 'published';
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && resource.data.status == 'published'
        && request.query.limit <= 50;
      allow write: if isAdmin();

      match /attendees/{attendeeId} {
        allow get: if isOwner(attendeeId) || isAdmin();
        allow list: if isAdmin() && request.query.limit <= 100;
        allow write: if false;
      }

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /teams/{communityId} {
      allow get: if signedIn() && isPublicActive(resource.data);
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && request.query.limit <= 50;
      allow write: if false;

      match /members/{memberId} {
        allow get: if isOwner(memberId) || isCommunityManager(communityId) || (
          signedIn()
          && get(/databases/$(database)/documents/teams/$(communityId)).data.visibility == 'public'
          && get(/databases/$(database)/documents/teams/$(communityId)).data.moderationState == 'active'
          && resource.data.status == 'active'
          && resource.data.removedAt == null
        );
        allow list: if signedIn()
          && request.query.limit <= 100
          && (
            (
              get(/databases/$(database)/documents/teams/$(communityId)).data.visibility == 'public'
              && get(/databases/$(database)/documents/teams/$(communityId)).data.moderationState == 'active'
              && resource.data.status == 'active'
              && resource.data.removedAt == null
            )
            || (
              isCommunityManager(communityId)
              && resource.data.status == 'pending'
              && resource.data.removedAt == null
            )
          );
        allow write: if false;
      }
    }

    match /trainer_profiles/{trainerId} {
      allow get: if signedIn()
        && resource.data.moderationState == 'active';
      allow list: if signedIn()
        && resource.data.moderationState == 'active'
        && resource.data.acceptingClients == true
        && request.query.limit <= 50;
      allow write: if false;
    }

    match /trainer_services/{serviceId} {
      allow get: if signedIn()
        && resource.data.moderationState == 'active'
        && resource.data.isActive == true;
      allow list: if signedIn()
        && resource.data.moderationState == 'active'
        && resource.data.isActive == true
        && request.query.limit <= 50;
      allow write: if false;
    }

    match /leaderboards/{leaderboardId} {
      allow get: if signedIn() && resource.data.isPublished == true;
      allow list: if signedIn()
        && resource.data.isPublished == true
        && request.query.limit <= 20;
      allow write: if false;
    }

    match /activities/{activityId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.query.limit <= 100;
      allow write: if false;
    }

    match /challenges/{challengeId} {
      allow get: if signedIn()
        && (
          isAdmin()
          || resource.data.creatorId == request.auth.uid
          || (
            isPublicActive(resource.data)
            && resource.data.status in ['scheduled', 'active', 'completed']
          )
        );
      allow list: if signedIn()
        && isPublicActive(resource.data)
        && resource.data.status == 'active'
        && request.query.limit <= 50;
      allow write: if false;

      match /participants/{participantId} {
        allow get: if isOwner(participantId)
          || canManageChallenge(challengeId);
        allow list: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.query.limit <= 100;
        allow write: if false;
      }

      match /leaderboard/{entryId} {
        allow get: if canReadChallenge(challengeId);
        allow list: if canReadChallenge(challengeId)
          && request.query.limit <= 100;
        allow write: if false;
      }

      match /submissions/{submissionId} {
        allow get: if signedIn()
          && (
            resource.data.userId == request.auth.uid
            || canManageChallenge(challengeId)
          );
        allow list: if canManageChallenge(challengeId)
          && request.query.limit <= 100;
        allow write: if false;
      }

      match /used_activities/{activityId} {
        allow read, write: if false;
      }

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /challenge_badges/{badgeId} {
      allow get: if signedIn() && resource.data.isActive == true;
      allow list: if signedIn()
        && resource.data.isActive == true
        && request.query.limit <= 100;
      allow write: if false;
    }

    match /challenge_rewards/{rewardId} {
      allow get: if signedIn() && resource.data.isActive == true;
      allow list: if signedIn()
        && resource.data.isActive == true
        && request.query.limit <= 100;
      allow write: if false;
    }

    match /reward_claims/{claimId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.query.limit <= 100;
      allow write: if false;
    }

    match /{path=**}/participants/{participantId} {
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.query.limit <= 100;
    }

    match /marketplace_categories/{categoryId} {
      allow get: if signedIn() && resource.data.isActive == true;
      allow list: if signedIn()
        && resource.data.isActive == true
        && request.query.limit <= 100;
      allow write: if isAdmin();
    }

    match /marketplace_listings/{listingId} {
      allow get: if canReadMarketplaceListing(resource.data) || isAdmin();
      // Public marketplace discovery is served by a rate-limited callable so
      // block, expiry, distance, moderation, and pagination checks are applied
      // consistently. Clients may only fetch a known listing document here.
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if isAdmin();

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /marketplace_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketplace_views/{viewId} {
      allow read, write: if false;
    }

    match /marketplace_threads/{threadId} {
      allow read, write: if false;
    }

    match /posts/{postId} {
      allow get: if canReadPublishedContent(resource.data);
      allow list: if signedIn()
        && resource.data.status == 'published'
        && resource.data.visibility == 'public'
        && resource.data.moderationState == 'active'
        && request.query.limit <= 25;
      allow write: if false;

      match /comments/{commentId} {
        allow get: if canReadPublishedContent(
          get(/databases/$(database)/documents/posts/$(postId)).data
        ) && resource.data.moderationState == 'active';
        allow list: if canReadPublishedContent(
          get(/databases/$(database)/documents/posts/$(postId)).data
        ) && resource.data.moderationState == 'active'
          && request.query.limit <= 50;
        allow write: if false;
      }
    }

    match /stories/{storyId} {
      allow get: if canReadStory(resource.data);
      // List omits expiresAt > request.time: that comparison causes an
      // evaluation error on bounded public story queries (story rail), which
      // surfaces as permission-denied even with a matching expiresAt filter.
      // Single-document reads still enforce expiry via canReadStory().
      allow list: if signedIn()
        && resource.data.visibility == 'public'
        && resource.data.moderationState == 'active'
        && request.query.limit <= 50;
      allow write: if false;
    }

    match /feed_entries/{entryId} {
      allow get: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow list: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.query.limit <= 25;
      allow write: if false;
    }

    match /content_reactions/{reactionId} {
      allow get: if signedIn()
        && reactionId.matches(request.auth.uid + '--.*');
      allow list: if false;
      allow write: if false;
    }

    match /reposts/{repostId} {
      allow get: if signedIn()
        && repostId.matches(request.auth.uid + '--.*');
      allow list: if signedIn()
        && resource.data.reposterId == request.auth.uid
        && request.query.limit <= 50;
      allow write: if false;
    }

    match /comment_reactions/{reactionId} {
      allow get: if signedIn()
        && reactionId.matches(request.auth.uid + '--.*');
      allow list, write: if false;
    }

    match /story_views/{viewId} {
      allow get: if signedIn()
        && viewId.matches(request.auth.uid + '--.*');
      allow list, write: if false;
    }

    match /post_views/{viewId} {
      allow read, write: if false;
    }

    match /media_assets/{assetId} {
      allow get: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow list, write: if false;
    }

    match /media_jobs/{jobId} {
      allow get: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow list, write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && hasOnlyKeys(request.resource.data, [
          'reporterId',
          'targetType',
          'targetId',
          'reason',
          'details',
          'status',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && hasRequiredKeys(request.resource.data, [
          'reporterId',
          'targetType',
          'targetId',
          'reason',
          'status',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && validCreateAudit(request.resource.data)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in [
          'user', 'post', 'comment', 'story', 'message', 'group',
          'event', 'challenge', 'marketplace_listing'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 100
        && (!('details' in request.resource.data)
          || (request.resource.data.details is string
            && request.resource.data.details.size() <= 2000))
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get: if activeConversationMember(conversationId) || isAdmin();
      allow list, create, update, delete: if false;

      match /members/{memberId} {
        allow get: if activeConversationMember(conversationId) || isAdmin();
        allow list: if (activeConversationMember(conversationId) || isAdmin())
          && request.query.limit <= 100;
        allow write: if false;
      }

      match /messages/{messageId} {
        allow get: if activeConversationMember(conversationId) || isAdmin();
        allow list: if (activeConversationMember(conversationId) || isAdmin())
          && request.query.limit <= 100;
        allow write: if false;

        match /reactions/{reactionId} {
          allow get: if activeConversationMember(conversationId) || isAdmin();
          allow list: if (activeConversationMember(conversationId) || isAdmin())
            && request.query.limit <= 100;
          allow write: if false;
        }
      }
    }

    match /message_reports/{reportId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /notification_deliveries/{deliveryId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /ai_usage/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /ai_audit_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /trainer_metrics/{trainerId} {
      allow get: if isOwner(trainerId) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /moderation_queue/{documentId} {
      // Server-only writes (Admin SDK / Cloud Functions). Admins may read.
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow write: if false;
    }

    match /audit_logs/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /data_migrations/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /account_deletions/{documentId} {
      allow read, write: if false;
    }

    match /rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
