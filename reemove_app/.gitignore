# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase generated configuration
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
.firebase/
.firebaserc

# Environment / secrets
.env
.env.*
!.env.example
!.env.test.example
functions/.env
functions/.env.*

# Signing / local release secrets
android/key.properties
**/*.jks
**/*.keystore
ios/ExportOptions.plist
!ios/ExportOptions.plist.template
ios/Flutter/Maps.xcconfig

# Dart defines with real owner values
dart_defines/*.json
!dart_defines/*.json.example

# Release outputs / evidence
release_evidence/
build/symbols/
**/*.aab
**/*.ipa
**/*.dSYM.zip

# Logs
firebase-debug.log
firestore-debug.log
ui-debug.log

# Node / Firebase tooling
node_modules/
functions/node_modules/
firebase_tests/node_modules/
functions/lib/
*.tsbuildinfo
