{
  "name": "reemove-firebase-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 src/*.test.mjs",
    "test:firestore": "node --test src/firestore.rules.test.mjs",
    "test:messaging": "node --test src/messaging.rules.test.mjs",
    "test:database": "node --test src/database.rules.test.mjs",
    "test:storage": "node --test src/storage.rules.test.mjs",
    "test:emulated": "firebase emulators:exec --project demo-reemove --only firestore,database,storage \"npm test\""
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0"
  }
}
