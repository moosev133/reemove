rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function isImageOrVideo() {
      return request.resource != null
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*'));
    }

    function validOwnerMetadata(uid) {
      return request.resource != null
        && request.resource.metadata.ownerId == uid
        && request.resource.metadata.schemaVersion == '1';
    }

    function preservesOwnerMetadata(uid) {
      return resource != null
        && resource.metadata.ownerId == uid
        && request.resource != null
        && request.resource.metadata.ownerId == uid
        && request.resource.metadata.schemaVersion == resource.metadata.schemaVersion;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)/members/$(request.auth.uid)).data.removedAt == null;
    }

    function isConversationAdmin(conversationId) {
      return isConversationMember(conversationId)
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    match /users/{uid}/avatar/{assetId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isImage()
        && validOwnerMetadata(uid);
      allow update: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isImage()
        && preservesOwnerMetadata(uid);
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid;
    }

    match /users/{uid}/cover/{assetId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && validOwnerMetadata(uid);
      allow update: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && preservesOwnerMetadata(uid);
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid;
    }

    match /content/{uid}/{draftId}/{assetId}/{filename} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size > 0
        && request.resource.size < 150 * 1024 * 1024
        && isImageOrVideo()
        && validOwnerMetadata(uid)
        && request.resource.metadata.draftId == draftId
        && request.resource.metadata.assetId == assetId
        && request.resource.metadata.kind in ['image', 'video']
        && ((request.resource.metadata.kind == 'image'
              && request.resource.contentType.matches('image/.*')
              && request.resource.size < 15 * 1024 * 1024)
          || (request.resource.metadata.kind == 'video'
              && request.resource.contentType.matches('video/.*')));
      allow update: if false;
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid
        && resource.metadata.draftId == draftId
        && resource.metadata.assetId == assetId;
    }

    match /processed_content/{uid}/{assetId}/{filename} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /processed/{uid}/{assetId}/{filename} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /posts/{uid}/{postId}/original/{assetId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.size < 250 * 1024 * 1024
        && isImageOrVideo()
        && validOwnerMetadata(uid);
      allow update: if isOwner(uid)
        && request.resource.size < 250 * 1024 * 1024
        && isImageOrVideo()
        && preservesOwnerMetadata(uid);
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid;
    }

    match /posts/{uid}/{postId}/processed/{assetId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /stories/{uid}/{storyId}/{assetId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.size < 150 * 1024 * 1024
        && isImageOrVideo()
        && validOwnerMetadata(uid);
      allow update: if isOwner(uid)
        && request.resource.size < 150 * 1024 * 1024
        && isImageOrVideo()
        && preservesOwnerMetadata(uid);
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid;
    }

    match /marketplace/{uid}/{listingId}/{assetId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && validOwnerMetadata(uid);
      allow update: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && preservesOwnerMetadata(uid);
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid;
    }

    match /verification/{uid}/{requestId}/{assetId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && validOwnerMetadata(uid);
      allow update: if false;
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid;
    }

    match /reports/{uid}/{reportId}/{assetId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size < 25 * 1024 * 1024
        && isImageOrVideo()
        && validOwnerMetadata(uid);
      allow update: if false;
      allow delete: if false;
    }

    match /challenge_proofs/{uid}/{challengeId}/{proofId}/{filename} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && validOwnerMetadata(uid)
        && request.resource.metadata.challengeId == challengeId
        && request.resource.metadata.proofId == proofId;
      allow update: if false;
      allow delete: if isOwner(uid)
        && resource.metadata.ownerId == uid
        && resource.metadata.challengeId == challengeId
        && resource.metadata.proofId == proofId;
    }

    match /messages/{conversationId}/{messageId}/{assetId}/{filename} {
      allow read: if isConversationMember(conversationId);
      allow create: if isConversationMember(conversationId)
        && request.resource.size > 0
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.metadata.ownerId == request.auth.uid
        && request.resource.metadata.conversationId == conversationId
        && request.resource.metadata.messageId == messageId
        && request.resource.metadata.assetId == assetId
        && request.resource.metadata.schemaVersion == '1'
        && request.resource.metadata.kind in ['image', 'video', 'audio']
        && ((request.resource.metadata.kind == 'image'
              && request.resource.contentType.matches('image/.*')
              && request.resource.size < 15 * 1024 * 1024)
          || (request.resource.metadata.kind == 'video'
              && request.resource.contentType.matches('video/.*')
              && request.resource.size < 100 * 1024 * 1024)
          || (request.resource.metadata.kind == 'audio'
              && request.resource.contentType.matches('audio/.*')
              && request.resource.size < 25 * 1024 * 1024));
      allow update: if false;
      allow delete: if isConversationMember(conversationId)
        && resource.metadata.ownerId == request.auth.uid
        && resource.metadata.conversationId == conversationId
        && resource.metadata.messageId == messageId
        && resource.metadata.assetId == assetId;
    }

    match /conversation_groups/{conversationId}/{uid}/{assetId}/{filename} {
      allow read: if isConversationMember(conversationId);
      allow create: if isOwner(uid)
        && isConversationAdmin(conversationId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && isImage()
        && validOwnerMetadata(uid)
        && request.resource.metadata.conversationId == conversationId;
      allow update: if false;
      allow delete: if isOwner(uid)
        && isConversationAdmin(conversationId)
        && resource.metadata.ownerId == uid;
    }

    match /groups/{groupId}/{assetId} {
      allow read, write: if false;
    }

    match /events/{eventId}/{assetId} {
      allow read, write: if false;
    }

    match /routes/{routeId}/{assetId} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
