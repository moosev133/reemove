{
  "name": "reemove-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "seed:emulator": "npm run build && node lib/seed/seedAuth.js && node lib/seed/seedFirestore.js",
    "test:unit": "npm run build && node --test test/*.test.cjs",
    "test:load-smoke": "node load/callable_load_smoke.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "geofire-common": "^6.0.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.0",
    "firebase": "^12.16.0",
    "typescript": "^5.8.3"
  }
}
